E3_SHIPMENT_STORAGE=auto
E3_SHIPMENT_DB_PATH=instance/e3_shipments.db
E3_SHIPMENT_RANDY_BACKUP_ENABLED=false
# Optional shipment-specific RANDY settings. Falls back to E3_RANDY_BASE_URL / E3_RANDY_TOKEN.
E3_SHIPMENT_RANDY_BASE_URL=https://randy.example/backup/e3
E3_SHIPMENT_RANDY_TOKEN=replace-me

# Preferred durable production source on Heroku when Postgres is attached.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Existing RANDY E3 data service settings.
E3_RANDY_BASE_URL=https://randy.example/backup/e3
E3_RANDY_TOKEN=replace-me

# RANDY-side durable shipment database path.
# On RANDY, point this at a persistent location such as:
# /home/jxs794/PROTAC_BUILDER/data/e3_shipments.db
